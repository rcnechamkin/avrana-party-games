{
  "requires": "avrana.party-games/v0",
  "required_by": "rcnechamkin/avrana-party-games",
  "description": "What this games server requires from Party (contracts/party-games.v0.json there). tests/test_avrana_contract.py checks this file against this repository; the Party checker (tools/contract_check.py) compares both declarations in both repositories' CI.",
  "session_protocol": {
    "version": "avrana.party-session/v0",
    "vendored": "core/party_protocol.py",
    "vendored_sha256": "a8f136157d269b7764b3ffb4b10f9df8ca93dc09df2427bbeaf7bf9f5f692271",
    "vectors": "tests/vectors/party-session.v0.json",
    "vectors_sha256": "07474dde39d46ecbc8c2f989db4c748ed63eb98f8740a6250807dc668493f794"
  },
  "result": {
    "schema": "avrana.game-result/v1",
    "carried_by": "ended.result",
    "vendored": "core/party_result.py",
    "vendored_sha256": "bbc883a589056348cb540e32027b98822e8f17299f2e18b746c60fe9486c1ccc",
    "vectors": "tests/vectors/game-result.v1.json",
    "vectors_sha256": "ddf391e061ae3a831347e56954fed744abc1c294f9e3a7a995d53f7d576d2f48",
    "reported_by": ["bluff"]
  },
  "bridge": {
    "protocol": "avrana.party-bridge/v1",
    "vendored": "web/avrana-party-bridge.js",
    "vendored_sha256": "11025f460d54b2b3082681758e72493b17e22eff5666e0f25bea65a0d29dff7d",
    "vectors": "tests/vectors/party-bridge.v1.json",
    "vectors_sha256": "4271426d9234c95a2b17b80b144698a4603f45dd8573d64b67441c3cc7026677",
    "party_origin_env": "AVRANA_PARTY_ORIGIN",
    "advertised_at": "/api/avrana"
  },
  "routes": {
    "party_ticket": "/party/api/session/ticket",
    "party_ended": "/internal/party-session/v0/ended",
    "game_launch": "/avrana/session/v0/launch",
    "game_end": "/avrana/session/v0/end"
  },
  "launch": {
    "integration": "avrana.lan-launch/v1",
    "marker": "avrana=1",
    "return_path": "/party/",
    "advertised_at": "/api/games"
  },
  "environment": {
    "keys_dir": "AVRANA_PARTY_KEYS",
    "party_url": "AVRANA_PARTY_URL"
  },
  "party_side_games": ["bluff", "expo"]
}
