# runtime data (user-uploaded avatars, chat media) — never commit.
# Root-relative so it does NOT catch game word-lists like games/wordclash/data/.
/data/*
# ...except the empty directory itself: a code release is built from tracked files, and the
# games service binds its state directory over data/ (deploy/avranaparty-games.service).
!/data/.gitkeep

# python
.venv
.venv/
venv
venv/
__pycache__/
*.pyc
.pytest_cache/

# node (playtest harness)
node_modules
node_modules/

# logs / scratch
nohup.out
*.log

# os / editor
.DS_Store
Thumbs.db

# local dev instance (avrana)
dev.pid

.env*
*.pem
*.key
*.tmp
/test-results/
/playwright-report/

# EXPO source material kept locally by maintainers (publisher PDFs, reference snapshots, early
# drafts): never commit. The canonical design record is games/expo/docs/ (AVR-215).
/games/The Crew II/

# git bundles
*.bundle

# Derived context, private Linear exports, and machine-specific Graphify state
/.graphify-context/
/graphify-out/
/graphify-public/
/.claude/*
!/.claude/settings.json
!/.claude/agents/
# Graphify query/export side effects beside the reviewed shared products stay local.
/context/graphify/*
!/context/graphify/semantic-graph.json
!/context/graphify/semantic-receipt.json
