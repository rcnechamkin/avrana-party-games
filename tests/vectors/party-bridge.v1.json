               "location": {"at": "game", "game": "bluff", "session": "session-0123"},
               "switching_to": null, "games": ["bluff", "arcade-gauntlet2"]},
      "public": {"party": true, "member": true, "host": false, "hostName": "Ana",
                 "location": {"at": "game", "game": "bluff"},
