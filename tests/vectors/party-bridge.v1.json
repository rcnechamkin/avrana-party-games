      "core": {"party": "party-0123", "version": 12, "state": "lobby", "host": "member-a",
               "members": [{"id": "member-a", "name": "Ana", "avatar": null, "presence": "here", "host": true}],
               "me": {"id": "member-a", "name": "Ana", "host": true},
               "session": {"id": "session-0123", "game": "bluff", "state": "ended", "outcome": "completed", "detail": null, "players": 2, "my_role": "player"},
