{
  "protocol": "avrana.party-bridge/v1",
  "description": "The postMessage contract between a game page and the Party's bridge frame (ADR 0013). `requests` are what a game page may send (web/party/lib/bridge.js parseRequest); `pushes` are what the bridge may send back (web/party/bridge/shim.js parsePush); `views` are what a game page is shown of a Party Core view (publicView). A games repository that vendors the shim tests it against this file unchanged.",
  "requests": [
    {"name": "hello names the game", "message": {"avrana": "avrana.party-bridge/v1", "type": "hello", "game": "bluff"}, "accept": {"type": "hello", "game": "bluff"}},
    {"name": "ticket", "message": {"avrana": "avrana.party-bridge/v1", "type": "ticket", "id": "r1"}, "accept": {"type": "ticket", "id": "r1"}},
    {"name": "end", "message": {"avrana": "avrana.party-bridge/v1", "type": "end", "id": "r2"}, "accept": {"type": "end", "id": "r2"}},
    {"name": "home", "message": {"avrana": "avrana.party-bridge/v1", "type": "home", "id": "r3"}, "accept": {"type": "home", "id": "r3"}},
    {"name": "playAgain", "message": {"avrana": "avrana.party-bridge/v1", "type": "playAgain", "id": "r4"}, "accept": {"type": "playAgain", "id": "r4"}},
    {"name": "another protocol version", "message": {"avrana": "avrana.party-bridge/v2", "type": "ticket", "id": "r1"}, "accept": null},
    {"name": "no protocol marker", "message": {"type": "ticket", "id": "r1"}, "accept": null},
    {"name": "a verb outside the closed set: launch another game", "message": {"avrana": "avrana.party-bridge/v1", "type": "launch", "id": "r1", "game": "spades"}, "accept": null},
    {"name": "a verb outside the closed set: transfer the host", "message": {"avrana": "avrana.party-bridge/v1", "type": "transfer", "id": "r1"}, "accept": null},
    {"name": "a verb outside the closed set: rename", "message": {"avrana": "avrana.party-bridge/v1", "type": "rename", "id": "r1"}, "accept": null},
    {"name": "a ticket request that names a game", "message": {"avrana": "avrana.party-bridge/v1", "type": "ticket", "id": "r1", "game": "spades"}, "accept": null},
    {"name": "a ticket request that names an origin", "message": {"avrana": "avrana.party-bridge/v1", "type": "ticket", "id": "r1", "origin": "https://party.avrana.net"}, "accept": null},
    {"name": "a navigation the game supplies", "message": {"avrana": "avrana.party-bridge/v1", "type": "navigate", "to": "https://evil.example/"}, "accept": null},
    {"name": "hello with a URL for a game", "message": {"avrana": "avrana.party-bridge/v1", "type": "hello", "game": "https://evil.example"}, "accept": null},
    {"name": "hello with no game", "message": {"avrana": "avrana.party-bridge/v1", "type": "hello"}, "accept": null},
    {"name": "hello with an extra field", "message": {"avrana": "avrana.party-bridge/v1", "type": "hello", "game": "bluff", "id": "r1"}, "accept": null},
    {"name": "no id", "message": {"avrana": "avrana.party-bridge/v1", "type": "end"}, "accept": null},
    {"name": "an id that is not a short token", "message": {"avrana": "avrana.party-bridge/v1", "type": "end", "id": "r 1"}, "accept": null},
    {"name": "an id that is not a string", "message": {"avrana": "avrana.party-bridge/v1", "type": "end", "id": 7}, "accept": null},
    {"name": "a string", "message": "ticket", "accept": null},
    {"name": "an array", "message": [{"avrana": "avrana.party-bridge/v1", "type": "ticket", "id": "r1"}], "accept": null},
    {"name": "null", "message": null, "accept": null}
  ],
  "pushes": [
    {"name": "a view", "accept": true, "message": {"avrana": "avrana.party-bridge/v1", "type": "view", "view": {"party": true, "member": true, "host": false, "hostName": "Ana", "location": {"at": "game", "game": "bluff"}, "round": {"game": "bluff", "state": "active", "outcome": null, "myRole": "player"}}}},
    {"name": "a view with no Party Core", "accept": true, "message": {"avrana": "avrana.party-bridge/v1", "type": "view", "view": {"party": false, "member": false, "host": false, "hostName": null, "location": {"at": "home", "game": null}, "round": null}}},
    {"name": "navigate to Party Home", "accept": true, "message": {"avrana": "avrana.party-bridge/v1", "type": "navigate", "to": "party"}},
    {"name": "a ticket", "accept": true, "message": {"avrana": "avrana.party-bridge/v1", "type": "ticket", "id": "r1", "ok": true, "ticket": "aps0.e30.AAAA", "role": "player", "expiresIn": 120}},
    {"name": "a refused ticket", "accept": true, "message": {"avrana": "avrana.party-bridge/v1", "type": "ticket", "id": "r1", "ok": false, "error": "no_game"}},
    {"name": "a host verb done", "accept": true, "message": {"avrana": "avrana.party-bridge/v1", "type": "result", "id": "r2", "ok": true, "error": null}},
    {"name": "a host verb refused", "accept": true, "message": {"avrana": "avrana.party-bridge/v1", "type": "result", "id": "r2", "ok": false, "error": "not_host"}},
    {"name": "navigate to a URL", "accept": false, "message": {"avrana": "avrana.party-bridge/v1", "type": "navigate", "to": "https://evil.example/"}},
    {"name": "navigate with a url field", "accept": false, "message": {"avrana": "avrana.party-bridge/v1", "type": "navigate", "to": "party", "url": "https://evil.example/"}},
    {"name": "a view carrying member ids", "accept": false, "message": {"avrana": "avrana.party-bridge/v1", "type": "view", "view": {"party": true, "member": true, "host": false, "hostName": "Ana", "location": {"at": "game", "game": "bluff"}, "round": null, "members": [{"id": "member-a"}]}}},
    {"name": "a view with an unknown location", "accept": false, "message": {"avrana": "avrana.party-bridge/v1", "type": "view", "view": {"party": true, "member": true, "host": false, "hostName": "Ana", "location": {"at": "admin", "game": null}, "round": null}}},
    {"name": "a ticket answer with no ticket", "accept": false, "message": {"avrana": "avrana.party-bridge/v1", "type": "ticket", "id": "r1", "ok": true}},
    {"name": "an answer with no id", "accept": false, "message": {"avrana": "avrana.party-bridge/v1", "type": "result", "ok": true, "error": null}},
    {"name": "an unknown type", "accept": false, "message": {"avrana": "avrana.party-bridge/v1", "type": "cookie", "value": "x"}},
    {"name": "another protocol", "accept": false, "message": {"avrana": "avrana.party-bridge/v2", "type": "navigate", "to": "party"}},
    {"name": "not an object", "accept": false, "message": "navigate"}
  ],
  "views": [
